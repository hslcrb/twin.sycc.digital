{
  "name": "sycc-blender-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:model": "node --import tsx --test scripts/tests/glb-inspect.test.mjs",
    "inspect:model": "node --import tsx scripts/glb-inspect.ts public/models/sycc.glb"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/three": "0.185.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
